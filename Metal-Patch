+    if (!queue || !EnsureScalerLocked(input_pixel_format, input_width, input_height, output_width,
+                                      output_height)) {
+      os_unfair_lock_unlock(&metalfx_lock);
+      return false;
+    }
+    id<CAMetalDrawable> drawable = [layer nextDrawable];
