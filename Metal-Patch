+void VulkanPresenter::PaintContext::DestroyMetalFXTarget() {
+  const VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (metalfx_last_submission) {
+    submission_tracker.AwaitSubmissionCompletion(metalfx_last_submission);
+    metalfx_last_submission = 0;
+  }
+  if (metalfx_framebuffer != VK_NULL_HANDLE) {
