+      // encode call. The descriptor's perceptual processing matches the
+      // normalized guest output the FSR path consumes.
+      metalfx_scaler.colorTexture = input;
+      metalfx_scaler.inputContentWidth = input_width;
+      metalfx_scaler.inputContentHeight = input_height;
+      metalfx_scaler.outputTexture = metalfx_output_texture;
+      [metalfx_scaler encodeToCommandBuffer:buffer];
+    } else {
+      os_unfair_lock_unlock(&metalfx_lock);
+      return false;
+    }
