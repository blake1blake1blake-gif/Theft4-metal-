+  if (metalfx_image != VK_NULL_HANDLE) {
+    dfn.vkDestroyImage(device, metalfx_image, nullptr);
+    metalfx_image = VK_NULL_HANDLE;
+  }
+  if (metalfx_memory != VK_NULL_HANDLE) {
+    dfn.vkFreeMemory(device, metalfx_memory, nullptr);
+    metalfx_memory = VK_NULL_HANDLE;
