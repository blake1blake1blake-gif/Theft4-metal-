@@ -0,0 +1,189 @@
+// Apple MetalFX spatial upscaler (Theft4 local, non-upstream).
+//
+// Alternative to the in-Vulkan FSR1 upscale: the Vulkan presenter renders the
+// guest output at scene resolution into an offscreen image, exports the
+// underlying MTLTexture, and this module upscales it to the drawable size
+// with MTLFXSpatialScaler before presenting. The caller guarantees the input
+// texture is GPU-complete (Vulkan paint fence waited on the CPU side), so no
+// cross-API event plumbing is needed for correctness here.
+//
+// Ordering note: this runs on the render-worker paint thread, never on the
+// main thread. All Metal objects are created lazily and guarded by a lock.
+
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+#import <QuartzCore/CAMetalLayer.h>
+#import <os/lock.h>
+
+#include "theft4_metalfx_spatial.h"
+
+#include "theft4_metal_presenter.h"
+
+namespace {
+
+// The Vulkan offscreen target uses the swapchain format (BGRA8Unorm, sRGB
+// variant on some configurations, or RGBA16Float for HDR-class content).
+// All three are in the MTLFXSpatialScaler supported input set.
+constexpr MTLPixelFormat kMetalFxOutputFormat = MTLPixelFormatBGRA8Unorm;
+
+bool MetalFxInputFormatSupported(uint32_t pixel_format) {
+  return pixel_format == MTLPixelFormatBGRA8Unorm ||
+         pixel_format == MTLPixelFormatBGRA8Unorm_sRGB ||
+         pixel_format == MTLPixelFormatRGBA16Float;
+}
